generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum AccountStatus {
  invited
  active
  suspended
  disabled
}

enum PermissionScope {
  own
  team
  department
  managed
  org
}

enum RevokedReason {
  logout
  password_change
  password_reset
  account_disabled
  deactivated
  role_removed
  reuse_detected
  user_revoke
  admin_revoke
}

enum AuthTokenPurpose {
  invite
  password_reset
}

enum OtpPurpose {
  password_reset
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
}

enum EmploymentStatus {
  active
  inactive
}

enum HistoryEventType {
  hired
  department_change
  designation_change
  status_change
  reactivated
}

enum AttendanceStatus {
  present
  late
  absent
}

enum AttendanceSource {
  web
  hr_correction
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum AssignmentType {
  self
  individual
  team
}

enum TaskOverallStatus {
  active
  cancelled
}

enum AssignmentStatus {
  todo
  in_progress
  in_review
  changes_requested
  done
  cancelled
}

enum SubmissionReviewStatus {
  pending
  approved
  changes_requested
  not_required
}

enum FeedbackKind {
  issue
  suggestion
}

enum FeedbackCategory {
  general
  attendance
  tasks
  system
  workplace
  other
}

enum FeedbackStatus {
  open
  in_review
  resolved
  closed
}

// ------------------------------------------------------
// 1. Identity & RBAC Models
// ------------------------------------------------------

model Organization {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.Text
  slug               String   @unique @db.Text
  timezone           String   @default("Asia/Dhaka") @db.Text
  settings           Json     @default("{\"workStart\":\"10:00\",\"graceMinutes\":15,\"workEnd\":\"18:30\",\"weekendDays\":[5,6]}")
  employeeCodePrefix String   @default("BST") @map("employee_code_prefix") @db.Text
  lastEmployeeNumber Int      @default(0) @map("last_employee_number")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  users         User[]
  roles         Role[]
  departments   Department[]
  designations  Designation[]
  holidays      Holiday[]
  employees     Employee[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model User {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  email             String        @db.Text
  displayName       String        @map("display_name") @db.Text
  passwordHash      String?       @map("password_hash") @db.Text
  accountStatus     AccountStatus @default(invited) @map("account_status")
  failedLoginCount  Int           @default(0) @map("failed_login_count")
  lockedUntil       DateTime?     @map("locked_until") @db.Timestamptz()
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz()
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz()
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  employee                   Employee?
  userRoles                  UserRole[]                   @relation("UserRolesTarget")
  userRolesAssigned          UserRole[]                   @relation("UserRoleAssigner")
  sessions                   UserSession[]
  authTokens                 AuthToken[]
  otpChallenges              OtpChallenge[]
  historyChangesMade         EmployeeEmploymentHistory[]  @relation("HistoryChangedBy")
  attendanceCorrectionsMade  AttendanceCorrection[]       @relation("AttendanceCorrectionUser")
  teamsCreated               Team[]                       @relation("TeamCreator")
  teamMembersAdded           TeamMember[]                 @relation("TeamMemberAddedBy")
  tasksCreated               Task[]                       @relation("TaskCreator")
  taskSubmissionsMade        TaskSubmission[]             @relation("TaskSubmissionSubmitter")
  taskSubmissionsReviewed    TaskSubmission[]             @relation("TaskSubmissionReviewer")
  taskComments               TaskComment[]                @relation("TaskCommentAuthor")
  taskStatusEventsActed      TaskStatusEvent[]            @relation("TaskStatusEventActor")
  feedbackItemsSubmitted     FeedbackItem[]               @relation("FeedbackSubmitter")
  feedbackItemsHandled       FeedbackItem[]               @relation("FeedbackHandler")
  notifications              Notification[]
  auditLogsActed             AuditLog[]                   @relation("AuditLogActor")
  idempotencyKeys            IdempotencyKey[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.Text
  description    String?  @db.Text
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique @db.Text
  description String @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assignedBy     String?  @map("assigned_by") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user     User  @relation("UserRolesTarget", fields: [organizationId, userId], references: [organizationId, id])
  role     Role  @relation(fields: [organizationId, roleId], references: [organizationId, id])
  assigner User? @relation("UserRoleAssigner", fields: [organizationId, assignedBy], references: [organizationId, id])

  @@id([userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model UserSession {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  familyId           String         @map("family_id") @db.Uuid
  refreshTokenHash   String         @unique @map("refresh_token_hash") @db.Text
  userAgent          String?        @map("user_agent") @db.Text
  ipAddress          String?        @map("ip_address") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt         DateTime       @default(now()) @map("last_used_at") @db.Timestamptz()
  rotatedAt          DateTime?      @map("rotated_at") @db.Timestamptz()
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz()
  absoluteExpiresAt  DateTime       @map("absolute_expires_at") @db.Timestamptz()
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz()
  revokedReason      RevokedReason? @map("revoked_reason")

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([familyId])
  @@index([absoluteExpiresAt])
  @@map("user_sessions")
}

model AuthToken {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  purpose        AuthTokenPurpose
  tokenHash      String           @unique @map("token_hash") @db.Text
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz()
  usedAt         DateTime?        @map("used_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([expiresAt])
  @@map("auth_tokens")
}

model OtpChallenge {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  purpose        OtpPurpose
  codeHash       String     @map("code_hash") @db.Text
  hmacKeyId      String     @map("hmac_key_id") @db.Text
  attempts       Int        @default(0) @db.SmallInt
  maxAttempts    Int        @default(5) @map("max_attempts") @db.SmallInt
  sentAt         DateTime   @default(now()) @map("sent_at") @db.Timestamptz()
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz()
  consumedAt     DateTime?  @map("consumed_at") @db.Timestamptz()
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@index([expiresAt])
  @@map("otp_challenges")
}

// ------------------------------------------------------
// 2. Organization Structure & Employees
// ------------------------------------------------------

model Department {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.Text
  description    String?   @db.Text
  headEmployeeId String?   @map("head_employee_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  headEmployee Employee?    @relation("DepartmentHead", fields: [organizationId, headEmployeeId], references: [organizationId, id])

  employees Employee[] @relation("DepartmentEmployees")
  teams     Team[]
  tasks     Task[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("departments")
}

model Designation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.Text
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, id])
  @@unique([organizationId, title])
  @@map("designations")
}

model Holiday {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  holidayDate    DateTime @map("holiday_date") @db.Date
  name           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, holidayDate])
  @@map("holidays")
}

model Employee {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  employeeCode     String           @map("employee_code") @db.Text
  firstName        String           @map("first_name") @db.Text
  lastName         String           @map("last_name") @db.Text
  workEmail        String           @map("work_email") @db.Text
  phone            String?          @db.Text
  departmentId     String           @map("department_id") @db.Uuid
  designationId    String           @map("designation_id") @db.Uuid
  employmentType   EmploymentType   @map("employment_type")
  employmentStatus EmploymentStatus @default(active) @map("employment_status")
  joiningDate      DateTime         @map("joining_date") @db.Date
  exitDate         DateTime?        @map("exit_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id])
  department   Department   @relation("DepartmentEmployees", fields: [organizationId, departmentId], references: [organizationId, id])
  designation  Designation  @relation(fields: [organizationId, designationId], references: [organizationId, id])

  profile                   EmployeeProfile?
  employmentHistory         EmployeeEmploymentHistory[]
  attendanceRecords         AttendanceRecord[]
  attendanceCorrections     AttendanceCorrection[]
  teamMemberships           TeamMember[]
  taskAssignments           TaskAssignment[]
  departmentsHeaded         Department[]                @relation("DepartmentHead")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, departmentId, employmentStatus])
  @@map("employees")
}

model EmployeeProfile {
  employeeId               String    @id @map("employee_id") @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  personalEmail            String?   @map("personal_email") @db.Text
  personalPhone            String?   @map("personal_phone") @db.Text
  addressLine              String?   @map("address_line") @db.Text
  city                     String?   @db.Text
  countryCode              String?   @map("country_code") @db.Char(2)
  emergencyContactName     String?   @map("emergency_contact_name") @db.Text
  emergencyContactPhone    String?   @map("emergency_contact_phone") @db.Text
  emergencyContactRelation String?   @map("emergency_contact_relation") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])

  @@unique([organizationId, employeeId])
  @@map("employee_profiles")
}

model EmployeeEmploymentHistory {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  eventType      HistoryEventType @map("event_type")
  effectiveDate  DateTime         @map("effective_date") @db.Date
  oldValue       Json?            @map("old_value")
  newValue       Json?            @map("new_value")
  reason         String?          @db.Text
  changedBy      String           @map("changed_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  employee  Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  changedByUser User @relation("HistoryChangedBy", fields: [organizationId, changedBy], references: [organizationId, id])

  @@index([employeeId, effectiveDate(sort: Desc), createdAt(sort: Desc)])
  @@map("employee_employment_history")
}

// ------------------------------------------------------
// 3. Attendance
// ------------------------------------------------------

model AttendanceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  workDate       DateTime         @map("work_date") @db.Date
  checkInAt      DateTime?        @map("check_in_at") @db.Timestamptz()
  status         AttendanceStatus
  source         AttendanceSource
  lateMinutes    Int              @default(0) @map("late_minutes")
  note           String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  employee    Employee               @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  corrections AttendanceCorrection[]

  @@unique([organizationId, id])
  @@unique([employeeId, workDate])
  @@index([organizationId, workDate, status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  attendanceRecordId String?          @map("attendance_record_id") @db.Uuid
  workDate           DateTime         @map("work_date") @db.Date
  correctedCheckInAt DateTime?        @map("corrected_check_in_at") @db.Timestamptz()
  correctedStatus    AttendanceStatus @map("corrected_status")
  reason             String           @db.Text
  originalSnapshot   Json?            @map("original_snapshot")
  correctedBy        String           @map("corrected_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  employee         Employee          @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  attendanceRecord AttendanceRecord? @relation(fields: [organizationId, attendanceRecordId], references: [organizationId, id])
  corrector        User              @relation("AttendanceCorrectionUser", fields: [organizationId, correctedBy], references: [organizationId, id])

  @@index([attendanceRecordId, createdAt(sort: Desc)])
  @@index([employeeId, workDate])
  @@map("attendance_corrections")
}

// ------------------------------------------------------
// 4. Teams & Tasks
// ------------------------------------------------------

model Team {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  departmentId   String    @map("department_id") @db.Uuid
  name           String    @db.Text
  description    String?   @db.Text
  createdBy      String    @map("created_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  department Department @relation(fields: [organizationId, departmentId], references: [organizationId, id])
  creator    User       @relation("TeamCreator", fields: [organizationId, createdBy], references: [organizationId, id])

  members TeamMember[]
  tasks   Task[]

  @@unique([organizationId, id])
  @@index([organizationId, departmentId])
  @@map("teams")
}

model TeamMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  addedBy        String    @map("added_by") @db.Uuid
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz()
  removedAt      DateTime? @map("removed_at") @db.Timestamptz()

  team     Team     @relation(fields: [organizationId, teamId], references: [organizationId, id])
  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  addedByUser User  @relation("TeamMemberAddedBy", fields: [organizationId, addedBy], references: [organizationId, id])

  @@map("team_members")
}

model Task {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  title          String            @db.Text
  description    String?           @db.Text
  priority       TaskPriority      @default(medium)
  dueDate        DateTime?         @map("due_date") @db.Date
  assignmentType AssignmentType    @map("assignment_type")
  teamId         String?           @map("team_id") @db.Uuid
  departmentId   String            @map("department_id") @db.Uuid
  requiresReview Boolean           @map("requires_review")
  status         TaskOverallStatus @default(active)
  createdBy      String            @map("created_by") @db.Uuid
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz()
  cancelReason   String?           @map("cancel_reason") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  team       Team?      @relation(fields: [organizationId, teamId], references: [organizationId, id])
  department Department @relation(fields: [organizationId, departmentId], references: [organizationId, id])
  creator    User       @relation("TaskCreator", fields: [organizationId, createdBy], references: [organizationId, id])

  assignments TaskAssignment[]
  comments    TaskComment[]

  @@unique([organizationId, id])
  @@index([organizationId, departmentId, status, dueDate])
  @@index([teamId])
  @@index([createdBy])
  @@map("tasks")
}

model TaskAssignment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  taskId         String           @map("task_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  status         AssignmentStatus @default(todo)
  startedAt      DateTime?        @map("started_at") @db.Timestamptz()
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz()
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  task     Task     @relation(fields: [organizationId, taskId], references: [organizationId, id])
  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id])

  submissions  TaskSubmission[]
  statusEvents TaskStatusEvent[]

  @@unique([organizationId, id])
  @@unique([taskId, employeeId])
  @@index([employeeId, status])
  @@index([taskId])
  @@map("task_assignments")
}

model TaskSubmission {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  assignmentId   String                 @map("assignment_id") @db.Uuid
  version        Int
  note           String                 @db.Text
  links          Json                   @default("[]")
  submittedBy    String                 @map("submitted_by") @db.Uuid
  submittedAt    DateTime               @default(now()) @map("submitted_at") @db.Timestamptz()
  reviewStatus   SubmissionReviewStatus @default(pending) @map("review_status")
  reviewedBy     String?                @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?              @map("reviewed_at") @db.Timestamptz()
  reviewNote     String?                @map("review_note") @db.Text

  assignment TaskAssignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id])
  submitter  User           @relation("TaskSubmissionSubmitter", fields: [organizationId, submittedBy], references: [organizationId, id])
  reviewer   User?          @relation("TaskSubmissionReviewer", fields: [organizationId, reviewedBy], references: [organizationId, id])

  @@unique([assignmentId, version])
  @@map("task_submissions")
}

model TaskComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  task   Task @relation(fields: [organizationId, taskId], references: [organizationId, id])
  author User @relation("TaskCommentAuthor", fields: [organizationId, authorUserId], references: [organizationId, id])

  @@index([taskId, createdAt, id])
  @@map("task_comments")
}

model TaskStatusEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  assignmentId   String            @map("assignment_id") @db.Uuid
  fromStatus     AssignmentStatus? @map("from_status")
  toStatus       AssignmentStatus  @map("to_status")
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  assignment TaskAssignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id])
  actor      User?          @relation("TaskStatusEventActor", fields: [organizationId, actorUserId], references: [organizationId, id])

  @@index([assignmentId, createdAt, id])
  @@map("task_status_events")
}

// ------------------------------------------------------
// 5. Feedback, Notifications, Audit & Platform
// ------------------------------------------------------

model FeedbackItem {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  submittedBy    String           @map("submitted_by") @db.Uuid
  kind           FeedbackKind
  category       FeedbackCategory
  subject        String           @db.Text
  body           String           @db.Text
  status         FeedbackStatus   @default(open)
  resolutionNote String?          @map("resolution_note") @db.Text
  handledBy      String?          @map("handled_by") @db.Uuid
  handledAt      DateTime?        @map("handled_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  submitter User  @relation("FeedbackSubmitter", fields: [organizationId, submittedBy], references: [organizationId, id])
  handler   User? @relation("FeedbackHandler", fields: [organizationId, handledBy], references: [organizationId, id])

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([submittedBy, createdAt(sort: Desc)])
  @@map("feedback_items")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.Text
  title          String    @db.Text
  body           String?   @db.Text
  payload        Json      @default("{}")
  dedupeKey      String    @map("dedupe_key") @db.Text
  readAt         DateTime? @map("read_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.Text
  entityType     String   @map("entity_type") @db.Text
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address") @db.Text
  userAgent      String?  @map("user_agent") @db.Text
  requestId      String?  @map("request_id") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("AuditLogActor", fields: [organizationId, actorUserId], references: [organizationId, id])

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  key            String    @db.Uuid
  requestHash    String    @map("request_hash") @db.Text
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()

  user User @relation(fields: [organizationId, userId], references: [organizationId, id])

  @@id([organizationId, userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
